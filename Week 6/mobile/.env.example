EXPO_PUBLIC_API_URL=http://localhost:3001/api
# Untuk Expo Go di HP, ganti localhost dengan IP LAN laptop (misalnya 192.168.1.20).
# HTTP hanya untuk latihan LAN pada mode development. API yang dipublikasikan wajib HTTPS.
EXPO_PUBLIC_ALLOW_INSECURE_LAN=true
# Opsional: client-error, forbidden, not-found, server-error, timeout, empty.
# Aktifkan ALLOW_TEST_SCENARIOS pada server untuk menguji Week 6.
EXPO_PUBLIC_TEST_SCENARIO=
